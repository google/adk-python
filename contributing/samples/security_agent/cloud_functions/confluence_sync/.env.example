# Confluence Cloud Function configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
BQ_DATASET_ID=security_data
BQ_TABLE_ID=confluence_documents
CONFLUENCE_SPACES=SEC,POLICY,GCP
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_USERNAME=confluence-user@example.com
CONFLUENCE_API_TOKEN=your-api-token
# Optional: override secret names if not using Secret Manager
SECRET_CONFLUENCE_URL=confluence-url
SECRET_CONFLUENCE_USER=confluence-username
SECRET_CONFLUENCE_TOKEN=confluence-api-token
