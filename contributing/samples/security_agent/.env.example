# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
# Update this path to point to your actual service account JSON file
# Example: /Users/username/path/to/your-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# Optional: If your service account file has a specific name pattern
SERVICE_ACCOUNT_FILENAME=your-service-account.json

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8501
BACKEND_URL=http://localhost:8000

# Vertex AI Configuration (if different from GOOGLE_CLOUD_PROJECT)
VERTEX_AI_PROJECT_ID=${GOOGLE_CLOUD_PROJECT}
VERTEX_AI_LOCATION=us-central1

# Optional: API Keys (if needed)
# GOOGLE_API_KEY=your-api-key-here

# Knowledge Base Configuration
KNOWLEDGE_BASE_DB_PATH=backend/cache/knowledge_base.db
# Backend API URL for frontend to connect to
BACKEND_API_URL=http://127.0.0.1:8000
# Backend API URL for the Streamlit frontend
BACKEND_API_URL="http://localhost:8000"