# Enhanced GCP Security Agent - Environment Configuration
# Copy this file to .env and fill in your values

# =====================================
# Google Cloud Project Configuration
# =====================================

# Your GCP Project ID (required)
GOOGLE_CLOUD_PROJECT=your-project-id

# =====================================
# Service Account Authentication
# =====================================

# Option 1: Service Account Key File (Recommended for local development)
# Note: Despite the confusing name, GOOGLE_APPLICATION_CREDENTIALS is Google's
# standard environment variable for service account key files (not ADC)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/path/to/your/service-account-key.json

# Standard Google Cloud environment variable (for compatibility with Google libraries)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Option 2: Service Account JSON (Alternative - for containerized environments)
# Complete service account JSON as a string (use this if you can't use file path)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# =====================================
# Application Configuration
# =====================================

# Default user email for analysis (optional)
DEFAULT_USER_EMAIL=user@example.com

# Backend URL (usually don't need to change)
BACKEND_URL=http://localhost:8000

# Server ports (optional)
BACKEND_PORT=8000
FRONTEND_PORT=8501
ADK_WEB_PORT=8080

# =====================================
# ADK Configuration
# =====================================

# Enable ADK evaluation features
ADK_EVALUATION_ENABLED=true

# =====================================
# Vertex AI Configuration (Optional)
# =====================================

# Vertex AI project (usually same as GOOGLE_CLOUD_PROJECT)
VERTEX_AI_PROJECT_ID=your-project-id

# Vertex AI location/region
VERTEX_AI_LOCATION=us-central1

# =====================================
# Service Account Permissions Required
# =====================================
# Your service account needs the following IAM roles:
# 
# Core Permissions:
# - Cloud Trace Agent (roles/cloudtrace.agent)
# - Logging Write (roles/logging.logWriter) 
# - Monitoring Write (roles/monitoring.metricWriter)
# - Service Usage Consumer (roles/serviceusage.serviceUsageConsumer)
# - Resource Manager Project Viewer (roles/resourcemanager.projectViewer)
# 
# Security Analysis Permissions:
# - IAM Security Reviewer (roles/iam.securityReviewer)
# - Security Center Findings Viewer (roles/securitycenter.findingsViewer)
# - Recommender Viewer (roles/recommender.viewer)
# 
# Optional (for enhanced features):
# - BigQuery Data Viewer (roles/bigquery.dataViewer)
# - Cloud SQL Viewer (roles/cloudsql.viewer)
# - Storage Object Viewer (roles/storage.objectViewer)

# =====================================
# Example Service Account Creation
# =====================================
# 
# 1. Create service account:
# gcloud iam service-accounts create security-agent --display-name="Security Agent"
# 
# 2. Add required roles:
# gcloud projects add-iam-policy-binding YOUR_PROJECT_ID \
#   --member="serviceAccount:security-agent@YOUR_PROJECT_ID.iam.gserviceaccount.com" \
#   --role="roles/cloudtrace.agent"
# 
# gcloud projects add-iam-policy-binding YOUR_PROJECT_ID \
#   --member="serviceAccount:security-agent@YOUR_PROJECT_ID.iam.gserviceaccount.com" \
#   --role="roles/logging.logWriter"
# 
# gcloud projects add-iam-policy-binding YOUR_PROJECT_ID \
#   --member="serviceAccount:security-agent@YOUR_PROJECT_ID.iam.gserviceaccount.com" \
#   --role="roles/monitoring.metricWriter"
# 
# gcloud projects add-iam-policy-binding YOUR_PROJECT_ID \
#   --member="serviceAccount:security-agent@YOUR_PROJECT_ID.iam.gserviceaccount.com" \
#   --role="roles/serviceusage.serviceUsageConsumer"
# 
# gcloud projects add-iam-policy-binding YOUR_PROJECT_ID \
#   --member="serviceAccount:security-agent@YOUR_PROJECT_ID.iam.gserviceaccount.com" \
#   --role="roles/resourcemanager.projectViewer"
# 
# gcloud projects add-iam-policy-binding YOUR_PROJECT_ID \
#   --member="serviceAccount:security-agent@YOUR_PROJECT_ID.iam.gserviceaccount.com" \
#   --role="roles/iam.securityReviewer"
# 
# gcloud projects add-iam-policy-binding YOUR_PROJECT_ID \
#   --member="serviceAccount:security-agent@YOUR_PROJECT_ID.iam.gserviceaccount.com" \
#   --role="roles/recommender.viewer"
# 
# 3. Create and download key:
# gcloud iam service-accounts keys create security-agent-key.json \
#   --iam-account=security-agent@YOUR_PROJECT_ID.iam.gserviceaccount.com
# 
# 4. Set environment variables:
# export GOOGLE_APPLICATION_CREDENTIALS="./security-agent-key.json"
# export GOOGLE_CLOUD_PROJECT="YOUR_PROJECT_ID"
#
# Note: This security agent is designed to work exclusively with service accounts
# for production-ready authentication and authorization.