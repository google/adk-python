{
  "dashboards": [
    {
      "id": "security-agent-overview",
      "title": "Security Agent - Overview Dashboard",
      "tags": ["security-agent", "overview"],
      "timezone": "browser",
      "refresh": "30s",
      "time": {
        "from": "now-1h",
        "to": "now"
      },
      "panels": [
        {
          "id": 1,
          "title": "Application Status",
          "type": "stat",
          "targets": [
            {
              "expr": "up{job=\"security-agent-app\"}",
              "legendFormat": "Application Status"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "steps": [
                  {
                    "color": "red",
                    "value": 0
                  },
                  {
                    "color": "green",
                    "value": 1
                  }
                ]
              },
              "mappings": [
                {
                  "options": {
                    "0": {
                      "text": "DOWN"
                    },
                    "1": {
                      "text": "UP"
                    }
                  },
                  "type": "value"
                }
              ]
            }
          },
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 0,
            "y": 0
          }
        },
        {
          "id": 2,
          "title": "Request Rate",
          "type": "stat",
          "targets": [
            {
              "expr": "rate(http_requests_total{job=\"security-agent-app\"}[5m])",
              "legendFormat": "Requests/sec"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "color": {
                "mode": "palette-classic"
              }
            }
          },
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 6,
            "y": 0
          }
        },
        {
          "id": 3,
          "title": "Response Time (95th percentile)",
          "type": "stat",
          "targets": [
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"security-agent-app\"}[5m]))",
              "legendFormat": "95th percentile"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "thresholds": {
                "steps": [
                  {
                    "color": "green",
                    "value": 0
                  },
                  {
                    "color": "yellow",
                    "value": 0.5
                  },
                  {
                    "color": "red",
                    "value": 1
                  }
                ]
              }
            }
          },
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 12,
            "y": 0
          }
        },
        {
          "id": 4,
          "title": "Error Rate",
          "type": "stat",
          "targets": [
            {
              "expr": "rate(http_requests_total{job=\"security-agent-app\",code=~\"5..\"}[5m]) / rate(http_requests_total{job=\"security-agent-app\"}[5m]) * 100",
              "legendFormat": "Error Rate %"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "thresholds": {
                "steps": [
                  {
                    "color": "green",
                    "value": 0
                  },
                  {
                    "color": "yellow",
                    "value": 1
                  },
                  {
                    "color": "red",
                    "value": 5
                  }
                ]
              }
            }
          },
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 18,
            "y": 0
          }
        },
        {
          "id": 5,
          "title": "HTTP Requests by Status Code",
          "type": "timeseries",
          "targets": [
            {
              "expr": "rate(http_requests_total{job=\"security-agent-app\"}[5m])",
              "legendFormat": "{{method}} {{code}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            }
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 4
          }
        },
        {
          "id": 6,
          "title": "Response Time Distribution",
          "type": "timeseries",
          "targets": [
            {
              "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"security-agent-app\"}[5m]))",
              "legendFormat": "50th percentile"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"security-agent-app\"}[5m]))",
              "legendFormat": "95th percentile"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"security-agent-app\"}[5m]))",
              "legendFormat": "99th percentile"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s"
            }
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 4
          }
        },
        {
          "id": 7,
          "title": "Memory Usage",
          "type": "timeseries",
          "targets": [
            {
              "expr": "process_resident_memory_bytes{job=\"security-agent-app\"}",
              "legendFormat": "RSS Memory"
            },
            {
              "expr": "process_virtual_memory_bytes{job=\"security-agent-app\"}",
              "legendFormat": "Virtual Memory"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "bytes"
            }
          },
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 12
          }
        },
        {
          "id": 8,
          "title": "CPU Usage",
          "type": "timeseries",
          "targets": [
            {
              "expr": "rate(process_cpu_seconds_total{job=\"security-agent-app\"}[5m]) * 100",
              "legendFormat": "CPU Usage %"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "max": 100,
              "min": 0
            }
          },
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 12
          }
        },
        {
          "id": 9,
          "title": "Active Connections",
          "type": "timeseries",
          "targets": [
            {
              "expr": "security_agent_active_connections{job=\"security-agent-app\"}",
              "legendFormat": "Active Connections"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            }
          },
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 16,
            "y": 12
          }
        }
      ]
    },
    {
      "id": "security-agent-database",
      "title": "Security Agent - Database Dashboard",
      "tags": ["security-agent", "database", "sqlite"],
      "timezone": "browser",
      "refresh": "30s",
      "panels": [
        {
          "id": 10,
          "title": "Database Size",
          "type": "stat",
          "targets": [
            {
              "expr": "sqlite_db_size_bytes{job=\"sqlite-exporter\"}",
              "legendFormat": "Database Size"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "bytes"
            }
          }
        },
        {
          "id": 11,
          "title": "Query Response Time",
          "type": "timeseries",
          "targets": [
            {
              "expr": "sqlite_query_duration_seconds{job=\"sqlite-exporter\"}",
              "legendFormat": "{{operation}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s"
            }
          }
        },
        {
          "id": 12,
          "title": "Database Connections",
          "type": "timeseries",
          "targets": [
            {
              "expr": "sqlite_connections_active{job=\"sqlite-exporter\"}",
              "legendFormat": "Active Connections"
            },
            {
              "expr": "sqlite_connections_idle{job=\"sqlite-exporter\"}",
              "legendFormat": "Idle Connections"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            }
          }
        }
      ]
    },
    {
      "id": "security-agent-security",
      "title": "Security Agent - Security Dashboard",
      "tags": ["security-agent", "security", "monitoring"],
      "timezone": "browser",
      "refresh": "30s",
      "panels": [
        {
          "id": 13,
          "title": "Failed Login Attempts",
          "type": "timeseries",
          "targets": [
            {
              "expr": "increase(security_agent_failed_logins_total{job=\"security-agent-app\"}[5m])",
              "legendFormat": "Failed Logins"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            }
          }
        },
        {
          "id": 14,
          "title": "Rate Limited Requests",
          "type": "timeseries",
          "targets": [
            {
              "expr": "increase(security_agent_rate_limited_requests_total{job=\"security-agent-app\"}[5m])",
              "legendFormat": "Rate Limited"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            }
          }
        },
        {
          "id": 15,
          "title": "Security Incidents",
          "type": "timeseries",
          "targets": [
            {
              "expr": "increase(security_agent_security_incidents_total{job=\"security-agent-app\"}[5m])",
              "legendFormat": "{{severity}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            }
          }
        }
      ]
    }
  ],
  "datasources": [
    {
      "name": "Prometheus",
      "type": "prometheus",
      "url": "http://prometheus:9090",
      "access": "proxy",
      "isDefault": true
    }
  ],
  "alerting": {
    "rules": [
      {
        "name": "security-agent-alerts",
        "rules": [
          {
            "alert": "SecurityAgentDown",
            "expr": "up{job=\"security-agent-app\"} == 0",
            "for": "1m",
            "labels": {
              "severity": "critical"
            },
            "annotations": {
              "summary": "Security Agent is down",
              "description": "Security Agent has been down for more than 1 minute."
            }
          },
          {
            "alert": "HighErrorRate",
            "expr": "rate(http_requests_total{job=\"security-agent-app\",code=~\"5..\"}[5m]) / rate(http_requests_total{job=\"security-agent-app\"}[5m]) * 100 > 5",
            "for": "5m",
            "labels": {
              "severity": "warning"
            },
            "annotations": {
              "summary": "High error rate detected",
              "description": "Error rate is above 5% for more than 5 minutes."
            }
          },
          {
            "alert": "HighResponseTime",
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"security-agent-app\"}[5m])) > 1",
            "for": "10m",
            "labels": {
              "severity": "warning"
            },
            "annotations": {
              "summary": "High response time detected",
              "description": "95th percentile response time is above 1 second for more than 10 minutes."
            }
          },
          {
            "alert": "DatabaseSizeGrowth",
            "expr": "increase(sqlite_db_size_bytes{job=\"sqlite-exporter\"}[1h]) > 100000000",
            "for": "0m",
            "labels": {
              "severity": "info"
            },
            "annotations": {
              "summary": "Rapid database growth detected",
              "description": "Database has grown by more than 100MB in the last hour."
            }
          }
        ]
      }
    ]
  }
}