# Development Environment Configuration Template
# Copy this file to .env.development and update values

# Application Configuration
ENVIRONMENT=development
APP_NAME=security-agent-dev
APP_VERSION=1.13.0-dev
APP_PORT=3000
APP_HOST=localhost
APP_DEBUG=true
APP_LOG_LEVEL=debug

# Security Configuration (Use simple values for development)
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET=dev-jwt-secret-change-in-production
ENCRYPTION_KEY=dev-encryption-key-32-chars-long
SESSION_SECRET=dev-session-secret-change-in-prod
CSRF_TOKEN_SECRET=dev-csrf-secret-change-in-prod

# API Keys (Use test keys when available)
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-your-anthropic-api-key}
OPENAI_API_KEY=${OPENAI_API_KEY:-your-openai-api-key}
GOOGLE_CLOUD_PROJECT_ID=${GOOGLE_CLOUD_PROJECT_ID:-your-dev-project}
GOOGLE_APPLICATION_CREDENTIALS=${GOOGLE_APPLICATION_CREDENTIALS:-./credentials/service-account-dev.json}

# Google Cloud Configuration (Development)
GCP_PROJECT_ID=${GCP_PROJECT_ID:-your-dev-gcp-project}
GCP_REGION=${GCP_REGION:-us-central1}
GCP_ZONE=${GCP_ZONE:-us-central1-a}
GCP_SERVICE_ACCOUNT_KEY=${GCP_SERVICE_ACCOUNT_KEY}
GCP_STORAGE_BUCKET=${GCP_STORAGE_BUCKET:-your-dev-bucket}

# Database Configuration (Local SQLite)
DATABASE_URL=sqlite:///./data/development.db
DATABASE_POOL_SIZE=5
DATABASE_TIMEOUT=10000
DATABASE_RETRY_ATTEMPTS=2
DATABASE_SSL_MODE=disable

# Redis Configuration (Local or Docker)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_MAX_CONNECTIONS=5
REDIS_TIMEOUT=3000

# Security Headers and CORS (Relaxed for development)
CORS_ORIGIN=http://localhost:3000,http://localhost:8501
CORS_CREDENTIALS=true
CSP_POLICY=default-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src *
HSTS_MAX_AGE=0

# Rate Limiting (Relaxed for development)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_SKIP_SUCCESSFUL=true

# Monitoring and Logging
LOG_FORMAT=pretty
LOG_FILE=./logs/app.log
ERROR_LOG_FILE=./logs/error.log
METRICS_ENABLED=true
METRICS_PORT=9091
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# Performance Configuration (Development optimized)
MAX_REQUEST_SIZE=50mb
REQUEST_TIMEOUT=60000
KEEP_ALIVE_TIMEOUT=5000
MAX_CONCURRENT_REQUESTS=100

# File Upload Configuration
UPLOAD_MAX_SIZE=10mb
UPLOAD_ALLOWED_TYPES=*
UPLOAD_STORAGE_PATH=./uploads

# Email Configuration (Use MailHog or similar for testing)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=dev@localhost
SMTP_TLS=false

# Backup Configuration (Disabled for development)
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_STORAGE_PATH=./backups

# Feature Flags (All enabled for development)
FEATURE_CHAT_ENABLED=true
FEATURE_DASHBOARD_ENABLED=true
FEATURE_API_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true

# Third-party Integrations (Optional in development)
SENTRY_DSN=${SENTRY_DSN}
NEW_RELIC_LICENSE_KEY=
DATADOG_API_KEY=
PAGERDUTY_INTEGRATION_KEY=

# Development/Testing Specific
DEBUG_ENABLED=true
TEST_MODE=false
MOCK_EXTERNAL_APIS=true
HOT_RELOAD=true
SOURCE_MAPS=true
VERBOSE_LOGGING=true

# Development Tools
NODEMON_ENABLED=true
LIVE_RELOAD_PORT=35729
DEVTOOLS_ENABLED=true

# Testing Configuration
TEST_DATABASE_URL=sqlite:///./data/test.db
TEST_TIMEOUT=30000
COVERAGE_THRESHOLD=80
TEST_PARALLEL=true