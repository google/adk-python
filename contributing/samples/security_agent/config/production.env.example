# Production Environment Configuration Template
# Copy this file to .env.production and update values

# Application Configuration
ENVIRONMENT=production
APP_NAME=security-agent
APP_VERSION=1.13.0
APP_PORT=8080
APP_HOST=0.0.0.0
APP_DEBUG=false
APP_LOG_LEVEL=info

# Security Configuration
SECRET_KEY=${SECRET_KEY:-generate-random-256-bit-key}
JWT_SECRET=${JWT_SECRET:-generate-random-jwt-secret}
ENCRYPTION_KEY=${ENCRYPTION_KEY:-generate-aes-256-key}
SESSION_SECRET=${SESSION_SECRET:-generate-session-secret}
CSRF_TOKEN_SECRET=${CSRF_TOKEN_SECRET:-generate-csrf-secret}

# API Keys and Authentication
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
OPENAI_API_KEY=${OPENAI_API_KEY}
GOOGLE_CLOUD_PROJECT_ID=${GOOGLE_CLOUD_PROJECT_ID}
GOOGLE_APPLICATION_CREDENTIALS=${GOOGLE_APPLICATION_CREDENTIALS:-/app/credentials/service-account.json}

# Google Cloud Configuration
GCP_PROJECT_ID=${GCP_PROJECT_ID}
GCP_REGION=${GCP_REGION:-us-central1}
GCP_ZONE=${GCP_ZONE:-us-central1-a}
GCP_SERVICE_ACCOUNT_KEY=${GCP_SERVICE_ACCOUNT_KEY}
GCP_STORAGE_BUCKET=${GCP_STORAGE_BUCKET}

# Database Configuration
DATABASE_URL=${DATABASE_URL:-sqlite:///app/data/production.db}
DATABASE_POOL_SIZE=${DATABASE_POOL_SIZE:-20}
DATABASE_TIMEOUT=${DATABASE_TIMEOUT:-30000}
DATABASE_RETRY_ATTEMPTS=${DATABASE_RETRY_ATTEMPTS:-3}
DATABASE_SSL_MODE=${DATABASE_SSL_MODE:-require}

# Redis Configuration (for caching and sessions)
REDIS_URL=${REDIS_URL:-redis://localhost:6379}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=${REDIS_DB:-0}
REDIS_MAX_CONNECTIONS=${REDIS_MAX_CONNECTIONS:-10}
REDIS_TIMEOUT=${REDIS_TIMEOUT:-5000}

# Security Headers and CORS
CORS_ORIGIN=${CORS_ORIGIN:-https://yourdomain.com}
CORS_CREDENTIALS=${CORS_CREDENTIALS:-true}
CSP_POLICY=${CSP_POLICY:-default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'}
HSTS_MAX_AGE=${HSTS_MAX_AGE:-31536000}

# Rate Limiting
RATE_LIMIT_WINDOW_MS=${RATE_LIMIT_WINDOW_MS:-900000}
RATE_LIMIT_MAX_REQUESTS=${RATE_LIMIT_MAX_REQUESTS:-100}
RATE_LIMIT_SKIP_SUCCESSFUL=${RATE_LIMIT_SKIP_SUCCESSFUL:-true}

# Monitoring and Logging
LOG_FORMAT=${LOG_FORMAT:-json}
LOG_FILE=${LOG_FILE:-/app/logs/app.log}
ERROR_LOG_FILE=${ERROR_LOG_FILE:-/app/logs/error.log}
METRICS_ENABLED=${METRICS_ENABLED:-true}
METRICS_PORT=${METRICS_PORT:-9090}
HEALTH_CHECK_ENABLED=${HEALTH_CHECK_ENABLED:-true}
HEALTH_CHECK_PATH=${HEALTH_CHECK_PATH:-/health}

# Performance Configuration
MAX_REQUEST_SIZE=${MAX_REQUEST_SIZE:-10mb}
REQUEST_TIMEOUT=${REQUEST_TIMEOUT:-30000}
KEEP_ALIVE_TIMEOUT=${KEEP_ALIVE_TIMEOUT:-5000}
MAX_CONCURRENT_REQUESTS=${MAX_CONCURRENT_REQUESTS:-1000}

# File Upload Configuration
UPLOAD_MAX_SIZE=${UPLOAD_MAX_SIZE:-5mb}
UPLOAD_ALLOWED_TYPES=${UPLOAD_ALLOWED_TYPES:-image/jpeg,image/png,text/plain,application/pdf}
UPLOAD_STORAGE_PATH=${UPLOAD_STORAGE_PATH:-/app/uploads}

# Email Configuration (for notifications)
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT:-587}
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
SMTP_FROM=${SMTP_FROM:-noreply@yourdomain.com}
SMTP_TLS=${SMTP_TLS:-true}

# Backup Configuration
BACKUP_ENABLED=${BACKUP_ENABLED:-true}
BACKUP_SCHEDULE=${BACKUP_SCHEDULE:-0 2 * * *}
BACKUP_RETENTION_DAYS=${BACKUP_RETENTION_DAYS:-30}
BACKUP_STORAGE_PATH=${BACKUP_STORAGE_PATH:-/app/backups}

# Feature Flags
FEATURE_CHAT_ENABLED=${FEATURE_CHAT_ENABLED:-true}
FEATURE_DASHBOARD_ENABLED=${FEATURE_DASHBOARD_ENABLED:-true}
FEATURE_API_ENABLED=${FEATURE_API_ENABLED:-true}
FEATURE_ANALYTICS_ENABLED=${FEATURE_ANALYTICS_ENABLED:-true}
FEATURE_NOTIFICATIONS_ENABLED=${FEATURE_NOTIFICATIONS_ENABLED:-true}

# Third-party Integrations
SENTRY_DSN=${SENTRY_DSN}
NEW_RELIC_LICENSE_KEY=${NEW_RELIC_LICENSE_KEY}
DATADOG_API_KEY=${DATADOG_API_KEY}
PAGERDUTY_INTEGRATION_KEY=${PAGERDUTY_INTEGRATION_KEY}

# Development/Testing Overrides (should be empty in production)
DEBUG_ENABLED=false
TEST_MODE=false
MOCK_EXTERNAL_APIS=false