# Docker Environment Configuration Template
# Used for containerized deployments

# Application Configuration
ENVIRONMENT=docker
APP_NAME=security-agent
APP_VERSION=1.13.0
APP_PORT=8080
APP_HOST=0.0.0.0
APP_DEBUG=false
APP_LOG_LEVEL=info

# Container Configuration
CONTAINER_NAME=security-agent
CONTAINER_RESTART_POLICY=unless-stopped
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_CPU_LIMIT=1.0
CONTAINER_HEALTHCHECK_INTERVAL=30s
CONTAINER_HEALTHCHECK_TIMEOUT=10s
CONTAINER_HEALTHCHECK_RETRIES=3

# Security Configuration
SECRET_KEY=${SECRET_KEY}
JWT_SECRET=${JWT_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}
SESSION_SECRET=${SESSION_SECRET}
CSRF_TOKEN_SECRET=${CSRF_TOKEN_SECRET}

# API Keys
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
OPENAI_API_KEY=${OPENAI_API_KEY}
GOOGLE_CLOUD_PROJECT_ID=${GOOGLE_CLOUD_PROJECT_ID}
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/service-account.json

# Google Cloud Configuration
GCP_PROJECT_ID=${GCP_PROJECT_ID}
GCP_REGION=${GCP_REGION:-us-central1}
GCP_ZONE=${GCP_ZONE:-us-central1-a}
GCP_SERVICE_ACCOUNT_KEY=${GCP_SERVICE_ACCOUNT_KEY}
GCP_STORAGE_BUCKET=${GCP_STORAGE_BUCKET}

# Database Configuration (Container paths)
DATABASE_URL=sqlite:////app/data/app.db
DATABASE_POOL_SIZE=15
DATABASE_TIMEOUT=25000
DATABASE_RETRY_ATTEMPTS=3
DATABASE_SSL_MODE=prefer

# Redis Configuration (Use service names in Docker Compose)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0
REDIS_MAX_CONNECTIONS=8
REDIS_TIMEOUT=4000

# Network Configuration
NETWORK_NAME=security-agent-network
NETWORK_DRIVER=bridge
NETWORK_SUBNET=172.20.0.0/16
NETWORK_GATEWAY=172.20.0.1

# Volume Configuration
DATA_VOLUME=security-agent-data
LOGS_VOLUME=security-agent-logs
UPLOADS_VOLUME=security-agent-uploads
BACKUP_VOLUME=security-agent-backups
CREDENTIALS_VOLUME=security-agent-credentials

# Persistent Volume Paths
DATA_PATH=/app/data
LOGS_PATH=/app/logs
UPLOADS_PATH=/app/uploads
BACKUP_PATH=/app/backups
CREDENTIALS_PATH=/app/credentials

# Security Headers and CORS
CORS_ORIGIN=${CORS_ORIGIN:-https://yourdomain.com}
CORS_CREDENTIALS=true
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'
HSTS_MAX_AGE=31536000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL=true

# Monitoring and Logging
LOG_FORMAT=json
LOG_FILE=/app/logs/app.log
ERROR_LOG_FILE=/app/logs/error.log
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# Performance Configuration
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=5000
MAX_CONCURRENT_REQUESTS=500
WORKER_PROCESSES=${WORKER_PROCESSES:-auto}

# File Upload Configuration
UPLOAD_MAX_SIZE=5mb
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,text/plain,application/pdf
UPLOAD_STORAGE_PATH=/app/uploads

# Email Configuration
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT:-587}
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
SMTP_FROM=${SMTP_FROM}
SMTP_TLS=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/app/backups

# Container Monitoring
MONITORING_ENABLED=true
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
JAEGER_ENABLED=false

# Docker Compose Services
REDIS_IMAGE=redis:7-alpine
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
NGINX_IMAGE=nginx:alpine

# Service Ports (Internal)
APP_INTERNAL_PORT=8080
REDIS_INTERNAL_PORT=6379
PROMETHEUS_INTERNAL_PORT=9090
GRAFANA_INTERNAL_PORT=3000
NGINX_INTERNAL_PORT=80

# Service Ports (External)
APP_EXTERNAL_PORT=8080
REDIS_EXTERNAL_PORT=6379
PROMETHEUS_EXTERNAL_PORT=9090
GRAFANA_EXTERNAL_PORT=3001
NGINX_EXTERNAL_PORT=80

# Feature Flags
FEATURE_CHAT_ENABLED=true
FEATURE_DASHBOARD_ENABLED=true
FEATURE_API_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true

# Third-party Integrations
SENTRY_DSN=${SENTRY_DSN}
NEW_RELIC_LICENSE_KEY=${NEW_RELIC_LICENSE_KEY}
DATADOG_API_KEY=${DATADOG_API_KEY}
PAGERDUTY_INTEGRATION_KEY=${PAGERDUTY_INTEGRATION_KEY}

# Container Security
RUN_AS_USER=10001
RUN_AS_GROUP=10001
SECURITY_OPT=no-new-privileges:true
READ_ONLY_ROOT_FILESYSTEM=true
DROP_CAPABILITIES=ALL
ADD_CAPABILITIES=CHOWN,SETGID,SETUID

# Resource Limits
MEMORY_RESERVATION=512m
MEMORY_LIMIT=2g
CPU_RESERVATION=0.25
CPU_LIMIT=1.0
PIDS_LIMIT=1024
ULIMIT_NOFILE=65536

# Development/Testing Overrides
DEBUG_ENABLED=false
TEST_MODE=false
MOCK_EXTERNAL_APIS=false