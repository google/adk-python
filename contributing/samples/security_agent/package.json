{
  "name": "security-agent-tests",
  "version": "1.0.0",
  "description": "E2E tests for ADK Security Agent",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:dashboard": "playwright test --grep dashboard",
    "test:chat": "playwright test --grep chat",
    "test:security": "playwright test --grep security",
    "test:api": "playwright test --grep api",
    "test:smoke": "playwright test --grep smoke",
    "test:all": "playwright test --project=chromium --project=firefox --project=webkit",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:8501"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.0.0"
  },
  "dependencies": {
    "2": "^3.0.0"
  }
}
