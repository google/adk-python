{
  "name": "gcp-security-agent",
  "display_name": "GCP Security Agent",
  "description": "Advanced security analysis and remediation agent for Google Cloud Platform",
  "version": "1.0.0",
  "agent_config": {
    "model": "gemini-2.0-flash-exp",
    "temperature": 0.7,
    "max_tokens": 8192,
    "system_instructions": "You are a GCP security expert that helps analyze and remediate security issues."
  },
  "tools": {
    "sqlite_tool": {
      "enabled": true,
      "description": "Query security data from SQLite cache"
    }
  },
  "deployment": {
    "cloud_run": {
      "memory": "2Gi",
      "cpu": "2",
      "timeout": 300,
      "max_instances": 10,
      "min_instances": 0,
      "allow_unauthenticated": false
    },
    "environment_variables": {
      "GOOGLE_GENAI_USE_VERTEXAI": "TRUE",
      "AGENT_MODE": "sqlite",
      "DATA_REFRESH_INTERVAL": "1800"
    }
  },
  "monitoring": {
    "enable_metrics": true,
    "metrics_port": 9090,
    "log_level": "INFO"
  },
  "features": {
    "token_streaming": true,
    "executive_dashboard": true,
    "real_time_analysis": true,
    "multi_turn_conversations": true,
    "background_cache_refresh": true
  }
}