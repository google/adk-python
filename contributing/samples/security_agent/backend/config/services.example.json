{
  "services": {
    "security": {
      "enabled_by_default": true,
      "config": {
        "scan_timeout": 300,
        "max_concurrent_scans": 5
      }
    },
    "iam": {
      "enabled_by_default": true,
      "config": {
        "cache_ttl": 300,
        "max_users_per_scan": 100
      }
    },
    "compliance": {
      "enabled_by_default": true,
      "config": {
        "frameworks": ["SOC2", "ISO27001", "GDPR", "HIPAA", "PCI-DSS"],
        "scan_depth": "detailed"
      }
    },
    "cloud_logging": {
      "enabled_by_default": true,
      "config": {
        "retention_days": 30,
        "log_levels": ["ERROR", "WARNING", "INFO"]
      }
    },
    "documentation": {
      "enabled_by_default": true,
      "config": {
        "cache_enabled": true,
        "cache_ttl": 3600
      }
    },
    "threat_intelligence": {
      "enabled_by_default": false,
      "config": {
        "nvd_api_key": "${NVD_API_KEY}",
        "update_frequency": "daily"
      }
    },
    "monitoring": {
      "enabled_by_default": false,
      "config": {
        "metrics_retention": 7,
        "alert_thresholds": {
          "cpu": 80,
          "memory": 85,
          "error_rate": 5
        }
      }
    },
    "security_analytics": {
      "enabled_by_default": false,
      "config": {
        "bigquery_dataset": "security_analytics",
        "query_timeout": 60
      }
    },
    "security_knowledge": {
      "enabled_by_default": false,
      "config": {
        "vertex_ai_location": "us-central1",
        "search_app_id": "${VERTEX_SEARCH_APP_ID}"
      }
    },
    "agent": {
      "enabled_by_default": true,
      "config": {
        "model": "gpt-4",
        "temperature": 0.7,
        "max_tokens": 4000
      }
    },
    "msa": {
      "enabled_by_default": false,
      "config": {
        "parse_timeout": 120,
        "max_file_size_mb": 50
      }
    },
    "tracing": {
      "enabled_by_default": false,
      "config": {
        "sample_rate": 0.1,
        "export_interval": 5
      }
    },
    "incident_response": {
      "enabled_by_default": false,
      "config": {
        "playbook_directory": "/config/playbooks",
        "notification_channels": []
      }
    },
    "apihub": {
      "enabled_by_default": false,
      "config": {
        "sync_interval": 3600,
        "auto_register": false
      }
    },
    "recommendations": {
      "enabled_by_default": true,
      "config": {
        "recommendation_engine": "ai",
        "priority_weights": {
          "security": 0.4,
          "performance": 0.2,
          "cost": 0.2,
          "compliance": 0.2
        }
      }
    }
  },
  "runtime_status": {
    "security": "not_configured",
    "iam": "not_configured",
    "compliance": "not_configured",
    "cloud_logging": "not_configured",
    "documentation": "not_configured",
    "threat_intelligence": "disabled",
    "monitoring": "disabled",
    "security_analytics": "disabled",
    "security_knowledge": "disabled",
    "agent": "not_configured",
    "msa": "disabled",
    "tracing": "disabled",
    "incident_response": "disabled",
    "apihub": "disabled",
    "recommendations": "not_configured",
    "gcp": "not_configured"
  }
}