# Multi-stage Docker build for Security Agent
# Optimized for production with security best practices

# Stage 1: Base Python image with security updates
FROM python:3.11-slim-bullseye AS base

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100 \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies and security updates
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    ca-certificates \
    && apt-get upgrade -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser -u 10001 appuser

# Stage 2: Dependencies installation
FROM base AS dependencies

# Copy requirements first for better layer caching
COPY requirements.txt /tmp/
COPY requirements-prod.txt /tmp/

# Create virtual environment and install dependencies
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip and install dependencies
RUN pip install --upgrade pip setuptools wheel \
    && pip install -r /tmp/requirements.txt \
    && pip install -r /tmp/requirements-prod.txt \
    && pip install gunicorn[gevent]==20.1.0 \
    && find /opt/venv -name "*.pyc" -delete \
    && find /opt/venv -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

# Stage 3: Application build
FROM base AS application

# Copy virtual environment from dependencies stage
COPY --from=dependencies /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Set working directory
WORKDIR /app

# Create necessary directories with proper permissions
RUN mkdir -p /app/data /app/logs /app/uploads /app/backups /app/credentials /app/static /app/templates \
    && chown -R appuser:appuser /app

# Copy application code
COPY --chown=appuser:appuser . /app/

# Remove development and test files
RUN rm -rf /app/tests /app/test_* /app/.git /app/.*ignore /app/docker-compose* \
    /app/Dockerfile* /app/README* /app/*.md /app/docs /app/examples

# Install Node.js for frontend assets (if needed)
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g npm@latest

# Build frontend assets (if package.json exists)
RUN if [ -f "package.json" ]; then \
        npm ci --only=production \
        && npm run build \
        && rm -rf node_modules package*.json; \
    fi

# Set proper permissions
RUN chown -R appuser:appuser /app \
    && chmod -R 755 /app \
    && chmod -R 777 /app/data /app/logs /app/uploads /app/backups

# Stage 4: Final production image
FROM python:3.11-slim-bullseye AS production

# Install only runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser -u 10001 appuser

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    PATH="/opt/venv/bin:$PATH" \
    ENVIRONMENT=production \
    APP_PORT=8080 \
    APP_HOST=0.0.0.0

# Copy virtual environment and application
COPY --from=application /opt/venv /opt/venv
COPY --from=application --chown=appuser:appuser /app /app

# Set working directory
WORKDIR /app

# Create volumes for persistent data
VOLUME ["/app/data", "/app/logs", "/app/uploads", "/app/backups", "/app/credentials"]

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${APP_PORT}/health || exit 1

# Expose port
EXPOSE 8080

# Default command with gunicorn for production
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "4", "--worker-class", "gevent", "--worker-connections", "1000", "--max-requests", "1000", "--max-requests-jitter", "50", "--preload", "--access-logfile", "/app/logs/access.log", "--error-logfile", "/app/logs/error.log", "--log-level", "info", "--timeout", "30", "--keep-alive", "5", "--graceful-timeout", "30", "app:app"]

# Labels for better container management
LABEL maintainer="Security Agent Team" \
      version="1.13.0" \
      description="Security Agent - Production optimized container" \
      org.opencontainers.image.source="https://github.com/your-org/security-agent" \
      org.opencontainers.image.documentation="https://github.com/your-org/security-agent/blob/main/README.md" \
      org.opencontainers.image.licenses="MIT" \
      security.scan="enabled" \
      security.updates="auto"