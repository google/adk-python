# Security Agent Environment Configuration
# Copy this file to .env and update with your values

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=backend/config/secrets/service-account-key.json

# Service Configuration (Simplified ADK)
# The ADK now uses only the legacy backend for maximum simplicity and reliability
USE_LEGACY=true
SERVICE_CONFIG_PATH=backend/config/services.json

# Server Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
RELOAD=true

# Frontend Configuration
FRONTEND_PORT=8501
FRONTEND_HOST=0.0.0.0

# Cloud Run Configuration (auto-detected, but can override)
K_SERVICE=
K_REVISION=
K_CONFIGURATION=

# Production Settings
PRODUCTION=false
DEBUG=true
WORKERS=1

# API Keys (if needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VERTEX_AI_LOCATION=us-central1

# Database Configuration (if using)
DATABASE_URL=

# Security Settings
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Feature Flags
ENABLE_TRACING=false
ENABLE_METRICS=false
ENABLE_PROFILING=false

# Service-specific Configuration
IAM_ANALYSIS_ENABLED=true
COMPLIANCE_ENABLED=true
THREAT_INTELLIGENCE_ENABLED=false
SECURITY_ANALYTICS_ENABLED=false

# Logging Configuration
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# Monitoring
SENTRY_DSN=
DATADOG_API_KEY=
PROMETHEUS_ENABLED=false