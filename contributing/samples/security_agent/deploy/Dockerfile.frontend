# Dockerfile for Unified Frontend with Executive Dashboard
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional frontend requirements
RUN pip install --no-cache-dir \
    streamlit==1.32.0 \
    plotly==5.18.0 \
    pandas==2.1.4 \
    google-genai==0.5.0 \
    google-cloud-aiplatform==1.52.0

# Copy the entire application
COPY . .

# Create necessary directories
RUN mkdir -p backend/cache frontend/cache logs

# Set environment variables for Cloud Run
ENV PYTHONPATH=/app
ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ENV GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Expose the Streamlit port
EXPOSE 8501

# Health check for Cloud Run
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Run the unified frontend
CMD ["python", "run_frontend.py", "--cloud"]