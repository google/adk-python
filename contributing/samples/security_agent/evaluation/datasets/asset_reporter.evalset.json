{
  "name": "Asset Inventory & Setting Reporter Evaluation",
  "description": "Comprehensive evaluation of asset discovery, configuration analysis, drift detection, and inventory reporting",
  "version": "1.0",
  "test_cases": [
    {
      "id": "asset_001",
      "name": "Comprehensive Asset Inventory",
      "input": "Show me a comprehensive inventory of all our GCP assets",
      "expected_output": {
        "contains": [
          "asset inventory",
          "GCP",
          "compute",
          "storage",
          "networking",
          "database",
          "configuration",
          "compliance"
        ],
        "tool_calls": [
          {
            "name": "query_security_data",
            "parameters": {
              "query_type": "asset_inventory"
            }
          }
        ]
      },
      "category": "asset_discovery"
    },
    {
      "id": "asset_002",
      "name": "Critical Asset Analysis",
      "input": "What critical assets do we have and are any publicly exposed?",
      "expected_output": {
        "contains": [
          "critical assets",
          "publicly exposed",
          "high importance",
          "security risk",
          "public access",
          "remediation"
        ],
        "tool_calls": [
          {
            "name": "query_security_data",
            "parameters": {
              "query_type": "asset_inventory",
              "parameters": "{\"importance\": \"CRITICAL\", \"public_only\": true}"
            }
          }
        ]
      },
      "category": "critical_assets"
    },
    {
      "id": "asset_003",
      "name": "Compute Asset Inventory",
      "input": "List all compute resources including instances, clusters, and serverless functions",
      "expected_output": {
        "contains": [
          "compute",
          "instances",
          "clusters",
          "serverless",
          "GKE",
          "Cloud Run",
          "functions",
          "virtual machines"
        ],
        "tool_calls": [
          {
            "name": "query_security_data",
            "parameters": {
              "query_type": "asset_inventory",
              "parameters": "{\"category\": \"COMPUTE\"}"
            }
          }
        ]
      },
      "category": "compute_assets"
    },
    {
      "id": "asset_004",
      "name": "Configuration Drift Detection",
      "input": "Check for configuration drift from our baseline settings",
      "expected_output": {
        "contains": [
          "configuration drift",
          "baseline",
          "settings",
          "deviation",
          "expected",
          "actual",
          "remediation"
        ],
        "tool_calls": [
          {
            "name": "query_security_data",
            "parameters": {
              "query_type": "configuration_drift"
            }
          }
        ]
      },
      "category": "configuration_drift"
    },
    {
      "id": "asset_005",
      "name": "Asset Inventory Report Generation",
      "input": "Generate a comprehensive asset inventory report for management",
      "expected_output": {
        "contains": [
          "inventory report",
          "comprehensive",
          "management",
          "summary",
          "compliance",
          "risk assessment",
          "recommendations"
        ],
        "tool_calls": [
          {
            "name": "query_security_data",
            "parameters": {
              "query_type": "asset_report",
              "parameters": "{\"report_type\": \"INVENTORY\"}"
            }
          }
        ]
      },
      "category": "report_generation"
    },
    {
      "id": "asset_006",
      "name": "Production Environment Analysis",
