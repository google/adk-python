    {
      "id": "vpcsc_001",
      "name": "VPC-SC Dry Run Analysis",
      "input": "Analyze VPC Service Controls dry run violations and assess enforcement readiness",
      "expected_output": {
        "contains": [
          "VPC Service Controls",
          "dry run",
          "violations",
          "enforcement",
          "readiness",
          "perimeter"
        ],
        "tool_calls": [
          {
            "name": "query_security_data",
            "parameters": {
              "query_type": "vpcsc_dry_run_analysis"
            }
          }
        ]
      },
      "category": "dry_run_analysis"
    },
    {
