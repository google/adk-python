# =============================================================================
# Customer Example Exclusions
# =============================================================================
# Local customer data that shouldn't be shared
customer_data/
private_configs/
internal_notes.md
TODO_INTERNAL.md

# Development scripts not for customers
dev_scripts/
internal_tools/

# =============================================================================
# Allow Important Configuration Files
# =============================================================================
# Explicitly allow these important files:
!requirements.txt
!package.json
!docker-compose.yml
!Dockerfile
!README.md
!ARCHITECTURE.md
!API_REFERENCE.md
!SERVICE_DOCUMENTATION.md
!services.example.json
!.env.example
!config.example.json

