.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.classpath

# Vim
*.swp
*.swo
*.un~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp

